{
  "version": 2,
  "builds": [
    {
      "src": "myproject/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 10
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/myproject/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/myproject/wsgi.py"
    }
  ]
}
